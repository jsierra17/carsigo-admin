# ─────────────────────────────────────────────────────────────
# .env.local  —  variables del día a día (desarrollo local)
# ─────────────────────────────────────────────────────────────
# Copia este archivo a .env.local y completa los valores.
#
# ⚠️  NO pongas aquí la service account de Firebase: da permisos
#     ADMIN sobre los datos de PRODUCCIÓN. Va en .env.seed
#     (ver .env.seed.example), que la API carga solo como último
#     recurso.
# ─────────────────────────────────────────────────────────────

# ── Firebase (Web SDK) ──
NEXT_PUBLIC_FIREBASE_API_KEY=TU_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=TU_PROYECTO.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=TU_PROYECTO
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=TU_PROYECTO.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=TU_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:SENDER:web:TU_APP_ID

# ── Google Maps (JavaScript API) ──
NEXT_PUBLIC_GOOGLE_MAPS_KEY=TU_KEY_MAPS_JAVASCRIPT

# ── Dueño del proyecto (email con bypass de superadmin) ──
OWNER_EMAIL=tu_email@gmail.com
NEXT_PUBLIC_OWNER_EMAIL=tu_email@gmail.com
