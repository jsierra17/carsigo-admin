rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helpers ─────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.role in ['admin', 'superadmin']);
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.role == 'superadmin';
    }

    // ── users ───────────────────────────────────────────────
    // Un nuevo usuario solo puede crear SU documento con rol 'passenger'
    // y un subconjunto seguro de campos. El rol lo cambia exclusivamente el
    // admin vía server actions (Admin SDK). Evita escalar a superadmin.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == 'passenger' &&
        request.resource.data.diff(resource).affectedKeys().hasOnly([
          'name', 'email', 'phone', 'role', 'status', 'created_at'
        ]) &&
        (request.resource.data.status == null || request.resource.data.status == 'pending') &&
        // Límites de tamaño: evita que un usuario agote la cuota de Firestore
        // con documentos de ~1 MB.
        (!('name' in request.resource.data) ||
          (request.resource.data.name is string && request.resource.data.name.size() <= 120)) &&
        (!('email' in request.resource.data) ||
          (request.resource.data.email is string && request.resource.data.email.size() <= 200)) &&
        (!('phone' in request.resource.data) ||
          (request.resource.data.phone is string && request.resource.data.phone.size() <= 40));
      allow update: if (isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        // Impedir limpiar claves como role/status ni tocar solo is_available
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'phone', 'photo_url', 'device_token',
          'first_name', 'last_name', 'id_number', 'profile_completed'
        ]) &&
        (!('name' in request.resource.data) ||
          (request.resource.data.name is string && request.resource.data.name.size() <= 120)) &&
        (!('email' in request.resource.data) ||
          (request.resource.data.email is string && request.resource.data.email.size() <= 200)) &&
        (!('phone' in request.resource.data) ||
          (request.resource.data.phone is string && request.resource.data.phone.size() <= 40)) &&
        // profile_completed solo puede pasarse a true por el propio usuario
        (!('profile_completed' in request.resource.data) ||
          request.resource.data.profile_completed == true) &&
        (!('first_name' in request.resource.data) ||
          (request.resource.data.first_name is string && request.resource.data.first_name.size() <= 100)) &&
        (!('last_name' in request.resource.data) ||
          (request.resource.data.last_name is string && request.resource.data.last_name.size() <= 100)) &&
        (!('id_number' in request.resource.data) ||
          (request.resource.data.id_number is string && request.resource.data.id_number.size() <= 20))
      ) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── driver_profiles (docId = user_id) ───────────────────
    // El conductor solo toca su flag is_available sobre SÍ MISMO.
    match /driver_profiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['is_available']));
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_available']));
      allow delete: if isAdmin();
    }

    // ── driver_applications ─────────────────────────────────
    // El postulante crea y lee la suya (pendiente); decisiones: admin vía
    // Admin SDK.
    match /driver_applications/{id} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'user_id', 'status', 'name', 'full_name', 'email', 'phone',
          'id_number', 'vehicle_type', 'plate', 'brand', 'model', 'color',
          'cedula_frente_url', 'cedula_reverso_url', 'propiedad_url',
          'seguro_url', 'licencia_url', 'soat_url', 'created_at'
        ]);
      allow update: if isAdmin() &&
        request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if isAdmin();
    }

    // ── settlements ─────────────────────────────────────────
    match /settlements/{id} {
      allow read: if isSignedIn() && (resource.data.driver_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── wallets ─────────────────────────────────────────────
    match /wallets/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // ── Datos de referencia (lectura para el pricing móvil) ─
    match /geofences/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /rate_cards/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /rate_schedules/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /dynamic_pricing_rules/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── trips ───────────────────────────────────────────────
    // Feed de conductores: trips pendientes o en negociación sin asignar.
    match /trips/{tripId} {
      allow read: if isSignedIn() && (
        resource.data.passenger_id == request.auth.uid ||
        resource.data.driver_id == request.auth.uid ||
        (resource.data.status in ['pending', 'negotiating'] && resource.data.driver_id == null) ||
        isAdmin()
      );

      // Helper: validación base de campos inmutables que nadie (excepto admin) puede tocar
      function tripImmutableFieldsUnchanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'driver_id', 'fare_offered', 'fare_counter_offer', 'fare_amount',
          'accepted_at', 'started_at', 'completed_at', 'driver_lat', 'driver_lng'
        ]);
      }

      // Helper: el conductor solo puede subir la oferta, nunca bajar de fare_calculated
      function driverFareValid() {
        return request.resource.data.fare_counter_offer >= resource.data.fare_calculated &&
               request.resource.data.fare_amount >= resource.data.fare_calculated;
      }

      // Helper: el pasajero solo puede subir su oferta, nunca bajar de fare_calculated
      function passengerFareValid() {
        return request.resource.data.fare_offered >= resource.data.fare_calculated &&
               request.resource.data.fare_amount >= resource.data.fare_calculated;
      }

      allow create: if (isSignedIn() && request.resource.data.passenger_id == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'id', 'passenger_id', 'passenger_name', 'status', 'pickup_address', 'dropoff_address',
          'pickup_lat', 'pickup_lng', 'dropoff_lat', 'dropoff_lng', 'pickup_location',
          'distance_km', 'duration_min', 'vehicle_type', 'zone_id',
          'fare_calculated', 'fare_offered', 'fare_amount', 'driver_id', 'created_at'
        ]) &&
        // Validación crítica: la oferta del pasajero no puede ser menor a la tarifa calculada
        request.resource.data.fare_offered >= request.resource.data.fare_calculated &&
        request.resource.data.fare_amount == request.resource.data.fare_offered &&
        request.resource.data.fare_calculated is number &&
        request.resource.data.fare_calculated >= 0 &&
        request.resource.data.fare_offered is number &&
        request.resource.data.fare_offered >= 0 &&
        request.resource.data.distance_km is number &&
        request.resource.data.distance_km >= 0 &&
        request.resource.data.pickup_lat is number &&
        request.resource.data.pickup_lat >= -90 && request.resource.data.pickup_lat <= 90 &&
        request.resource.data.pickup_lng is number &&
        request.resource.data.pickup_lng >= -180 && request.resource.data.pickup_lng <= 180 &&
        request.resource.data.vehicle_type in ['moto', 'car']) || isAdmin();

      allow update: if isAdmin() ||
        // Pasajero: cancelar su propio viaje
        (isSignedIn() && resource.data.passenger_id == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status in ['cancelled', 'pending']) ||
        // Pasajero: aceptar contraoferta del conductor (negotiating -> accepted)
        (isSignedIn() && resource.data.passenger_id == request.auth.uid &&
          resource.data.status == 'negotiating' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'accepted_at']) &&
          // El precio final ya está en fare_amount (la contraoferta)
          request.resource.data.fare_amount == resource.data.fare_counter_offer) ||
        // Conductor: hacer contraoferta (pending -> negotiating)
        (isSignedIn() && resource.data.driver_id == null &&
          resource.data.status == 'pending' &&
          request.resource.data.driver_id == request.auth.uid &&
          request.resource.data.status == 'negotiating' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'driver_id', 'status', 'fare_counter_offer', 'fare_amount'
          ]) &&
          driverFareValid()) ||
        // Conductor: aceptar oferta del pasajero (pending/negotiating -> accepted)
        (isSignedIn() && resource.data.driver_id == request.auth.uid &&
          resource.data.status in ['pending', 'negotiating'] &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'accepted_at'
          ])) ||
        // Conductor: mover el viaje por su ciclo de vida (accepted -> inProgress -> completed | cancelled)
        (isSignedIn() && resource.data.driver_id == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'started_at', 'completed_at']) &&
          request.resource.data.status in [
            'inProgress', 'started', 'active', 'completed', 'cancelled'
          ]) ||
        // Asignación simple: conductor se asigna un trip pendiente sin driver (sin negociación)
        (isSignedIn() &&
          request.resource.data.driver_id == request.auth.uid &&
          resource.data.status == 'pending' && resource.data.driver_id == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driver_id', 'status']) &&
          request.resource.data.status == 'accepted');
      allow delete: if isSuperAdmin();
    }

    // ── trip_fare_breakdown ─────────────────────────────────
    match /trip_fare_breakdown/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}