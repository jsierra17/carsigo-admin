GOOGLE_WEB_SERVICES_KEY=tu-key-de-web-services-aqui
# Las API keys de Google solo admiten una familia de restriccion de cliente
# por clave. Se necesita una clave por plataforma:
#   GOOGLE_WEB_SERVICES_KEY     -> Android (com.carsigo.app)
#   GOOGLE_WEB_SERVICES_KEY_IOS -> iOS (com.example.carsigoMobile)
GOOGLE_WEB_SERVICES_KEY_IOS=tu-key-de-web-services-para-ios
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
