# ─────────────────────────────────────────────────────────────
# CarSiGo Admin API - Variables de entorno
# Copiar a .env y completar. NUNCA subir el .env real.
# ─────────────────────────────────────────────────────────────

# Puerto del servidor
PORT=4000

# Ruta ABSOLUTA al service account JSON de Firebase (Admin SDK).
# Alternativa: Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT=C:\ruta\a\tu-service-account.json

# Email del dueño del proyecto (bypass de superadmin en la UI)
OWNER_EMAIL=todoobraparabien1998@gmail.com

# Orígenes permitidos del panel Vue (separados por coma). "*" permite cualquiera.
ALLOWED_ORIGINS=http://localhost:5173

# Zona de precios por defecto (slug del municipio en `geofences`)
DEFAULT_ZONE_ID=el-carmen-de-bolivar
