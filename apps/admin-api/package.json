{
  "name": "@carsigo/admin-api",
  "version": "1.0.0",
  "private": true,
  "description": "CarSiGo Admin API - Express + Firebase Admin SDK (ES Modules)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
