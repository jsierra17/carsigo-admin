{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": [
    "src",
    "api-src"
  ],
  "exclude": [
    "node_modules",
    "api-src/routes/_legacy_next_api"
  ]
}
