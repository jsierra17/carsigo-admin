# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (panel migrado a Vue: solo queda por transición)
/.next/
/out/

# vue / vite
**/dist/
**/.vite/
**/*.local

# production
/build

# artefactos de scripts
/geofence_output.json

# misc
.DS_Store
*.pem

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI agent tool dirs
.agents/
.augment/
.claude/
.kilocode/
.qoder/
.qwen/
.roo/
.trae/
.windsurf/

# build del panel copiado a firebase/public (generado por scripts/copy-web-dist.js)
/firebase/public/

# caches del CLI de Firebase
.firebase/
**/.firebase/

# restos de Expo / React Native (el movil real es Flutter)
/.expo/
/android/
/app.json

# logs del emulador de Firebase
firestore-debug.log
firebase-debug.log

# service account de produccion (acceso total) - se carga aparte a proposito
.env.seed
!.env.seed.example
